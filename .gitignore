# Dependencies
node_modules/

# Build output
dist/
.dist/
build/
.turbo/

# Local env
# Catch-all: any .env / .env.<mode> / .env.<mode>.local, at the repo root or in
# any app. The old list only covered `.env`, `.env.local` and `.env.*.local`, so
# a mode file like `.env.houzs` was NOT ignored and would commit on `git add .`.
# `*.example` files are the templates and stay tracked.
.env
.env.*
!.env.example
!.env.*.example

# Cloudflare
.wrangler/
.dev.vars

# Logs
*.log

# Editor / OS
.DS_Store
Thumbs.db
.idea/

# TypeScript
*.tsbuildinfo

# Test
coverage/
playwright-report/
test-results/
.playwright-mcp/

# Debug screenshots at repo root (not source assets — prototype/assets/ stays in)
/*.png

# Prototype working artifacts (not canonical spec)
prototype/uploads/
prototype/screenshots/
prototype/_test/

# claude-mem auto-generated context file (per-session, regenerates)
AGENTS.md

# understand-anything: local analysis cache, not repo state.
.ua/

# Brainstorming visual companion (mockups, server state)
.superpowers/

# Supabase CLI link config (per-machine, not part of repo state)
supabase/

# Local mockup HTML for visual companion / screenshot-only exploration
verify-*.html
.gstack/
.claude/worktrees/
